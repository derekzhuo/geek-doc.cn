### 2. 写 br0 专用配置（不读 /etc/dnsmasq.conf，--conf-file 独立）
# br0 独立 dnsmasq：只服务 10.88.0.0/24 的 tap 客户机
interface=br0
bind-dynamic
dhcp-range=10.88.0.50,10.88.0.150,255.255.255.0,12h
dhcp-option=option:router,10.88.0.1
dhcp-option=option:dns-server,10.88.0.1
log-dhcp
log-facility=/home/ubuntu/soc-qemu-b2/q075-tap/dnsmasq.log
pid-file=/home/ubuntu/soc-qemu-b2/q075-tap/dnsmasq.pid
leasefile-ro

