/* 教学用最小 liberty：一个 DFF + NAND2/INV/BUF，标量延时，自洽但不对应任何真实工艺。
   产线请替换为 sky130 等真实 PDK 库。 */
library(teaching_only) {
  time_unit : "1ns";
  delay_model : table_lookup;
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1, pf);
  input_threshold_pct_rise : 50.0;
  output_threshold_pct_rise : 50.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_lower_threshold_pct_fall : 20.0;
  slew_upper_threshold_pct_fall : 80.0;

  cell(DFF_P) {
    ff(IQ, IQN) {
      clocked_on : "C";
      next_state : "D";
    }
    pin(D) {
      direction : input;
      capacitance : 0.002;
      timing() {
        related_pin : "C";
        timing_type : setup_rising;
        rise_constraint(scalar) { values("0.10"); }
        fall_constraint(scalar) { values("0.10"); }
      }
      timing() {
        related_pin : "C";
        timing_type : hold_rising;
        rise_constraint(scalar) { values("0.02"); }
        fall_constraint(scalar) { values("0.02"); }
      }
    }
    pin(C) {
      direction : input;
      clock : true;
      capacitance : 0.001;
    }
    pin(Q) {
      direction : output;
      function : "IQ";
      timing() {
        related_pin : "C";
        timing_type : rising_edge;
        cell_rise(scalar) { values("0.20"); }
        cell_fall(scalar) { values("0.20"); }
        rise_transition(scalar) { values("0.05"); }
        fall_transition(scalar) { values("0.05"); }
      }
    }
  }

  cell(NAND2_X1) {
    area : 2;
    pin(A) { direction : input; capacitance : 0.001; }
    pin(B) { direction : input; capacitance : 0.001; }
    pin(Y) {
      direction : output;
      function : "((A B)')";
      timing() {
        related_pin : "A";
        timing_type : combinational;
        cell_rise(scalar) { values("0.12"); }
        cell_fall(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.03"); }
        fall_transition(scalar) { values("0.03"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        cell_rise(scalar) { values("0.12"); }
        cell_fall(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.03"); }
        fall_transition(scalar) { values("0.03"); }
      }
    }
  }

  cell(INV_X1) {
    area : 1;
    pin(A) { direction : input; capacitance : 0.001; }
    pin(Y) {
      direction : output;
      function : "A'";
      timing() {
        related_pin : "A";
        timing_type : combinational;
        cell_rise(scalar) { values("0.08"); }
        cell_fall(scalar) { values("0.07"); }
        rise_transition(scalar) { values("0.02"); }
        fall_transition(scalar) { values("0.02"); }
      }
    }
  }

  cell(BUF_X1) {
    area : 1;
    pin(A) { direction : input; capacitance : 0.001; }
    pin(Y) {
      direction : output;
      function : "A";
      timing() {
        related_pin : "A";
        timing_type : combinational;
        cell_rise(scalar) { values("0.10"); }
        cell_fall(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.02"); }
        fall_transition(scalar) { values("0.02"); }
      }
    }
  }
}
