#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55746db51d80 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55746db60350 .scope module, "counter_tb" "counter_tb" 3 5;
 .timescale -9 -12;
v0x55746db78c10_0 .var "clk", 0 0;
v0x55746db78cd0_0 .net "count", 3 0, v0x55746db4f2a0_0;  1 drivers
v0x55746db78d70_0 .var "en", 0 0;
v0x55746db78e40_0 .var "rst_n", 0 0;
S_0x55746db604e0 .scope module, "dut" "counter" 3 13, 4 3 0, S_0x55746db60350;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 4 "count";
v0x55746db4ecc0_0 .net "clk", 0 0, v0x55746db78c10_0;  1 drivers
v0x55746db4f2a0_0 .var "count", 3 0;
v0x55746db4f380_0 .net "en", 0 0, v0x55746db78d70_0;  1 drivers
v0x55746db51a00_0 .net "rst_n", 0 0, v0x55746db78e40_0;  1 drivers
E_0x55746db3a640 .event posedge, v0x55746db4ecc0_0;
    .scope S_0x55746db604e0;
T_0 ;
    %wait E_0x55746db3a640;
    %load/vec4 v0x55746db51a00_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x55746db4f2a0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55746db4f380_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55746db4f2a0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x55746db4f2a0_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55746db60350;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55746db78c10_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x55746db60350;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x55746db78c10_0;
    %inv;
    %store/vec4 v0x55746db78c10_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x55746db60350;
T_3 ;
    %vpi_call/w 3 27 "$dumpfile", "out/counter.vcd" {0 0 0};
    %vpi_call/w 3 28 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55746db60350 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55746db78e40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55746db78d70_0, 0, 1;
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55746db78e40_0, 0, 1;
    %vpi_call/w 3 33 "$display", "[%0t ns] release reset, count=%0d", $time, v0x55746db78cd0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55746db78d70_0, 0, 1;
    %pushi/vec4 20, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x55746db3a640;
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %vpi_call/w 3 38 "$display", "[%0t ns] after 20 enabled clocks, count=%0d", $time, v0x55746db78cd0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55746db78d70_0, 0, 1;
    %pushi/vec4 3, 0, 32;
T_3.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.3, 5;
    %jmp/1 T_3.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x55746db3a640;
    %jmp T_3.2;
T_3.3 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %vpi_call/w 3 43 "$display", "[%0t ns] paused 3 clocks, count=%0d (should hold)", $time, v0x55746db78cd0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55746db78d70_0, 0, 1;
    %pushi/vec4 5, 0, 32;
T_3.4 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.5, 5;
    %jmp/1 T_3.5, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x55746db3a640;
    %jmp T_3.4;
T_3.5 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %vpi_call/w 3 48 "$display", "[%0t ns] after 5 more clocks, count=%0d (wrap check)", $time, v0x55746db78cd0_0 {0 0 0};
    %vpi_call/w 3 50 "$display", "[%0t ns] TEST PASS: counter works as expected", $time {0 0 0};
    %vpi_call/w 3 51 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x55746db60350;
T_4 ;
    %wait E_0x55746db3a640;
    %vpi_call/w 3 56 "$display", "[%0t ns] clk posedge: rst_n=%b en=%b count=%0d", $time, v0x55746db78e40_0, v0x55746db78d70_0, v0x55746db78cd0_0 {0 0 0};
    %jmp T_4;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "counter_tb.v";
    "counter.v";
