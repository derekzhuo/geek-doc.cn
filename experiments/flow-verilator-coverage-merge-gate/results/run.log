//      // verilator_coverage annotation
        // 8 位可加载计数器：rst_n 异步复位，load 优先于 clear，clear 优先于 en，
        // 计满 255 后自然回绕到 0。三个种子的激励都不驱动 clear，
        // 用来制造一个合并后仍存在的真实覆盖缺口。
        module counter #(
            parameter int WIDTH = 8
        ) (
 000103     input  logic             clk,
%000003     input  logic             rst_n,
%000008     input  logic             en,
%000006     input  logic             load,
%000000     input  logic             clear,
%000001     input  logic [WIDTH-1:0] d,
%000002     output logic [WIDTH-1:0] q
        );
 000053     always_ff @(posedge clk or negedge rst_n) begin
%000006         if (!rst_n) begin
%000006             q <= '0;
%000003         end else if (load) begin
%000003             q <= d;
%000000         end else if (clear) begin
%000000             q <= '0;
%000004         end else if (en) begin
 000040             q <= q + 1'b1;
                end
            end
        endmodule
        
