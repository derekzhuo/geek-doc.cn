:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55b83c0cc560 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55b83c0cc710 .scope module, "counter" "counter" 3 4;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /OUTPUT 4 "count";
    .port_info 4 /OUTPUT 1 "ovf";
o0x7fb470fcd018 .functor BUFZ 1, C4<z>; HiZ drive
v0x55b83c0ddd50_0 .net "clk", 0 0, o0x7fb470fcd018;  0 drivers
v0x55b83c0de430_0 .var "count", 3 0;
o0x7fb470fcd078 .functor BUFZ 1, C4<z>; HiZ drive
v0x55b83c1159e0_0 .net "en", 0 0, o0x7fb470fcd078;  0 drivers
v0x55b83c115ab0_0 .var "ovf", 0 0;
o0x7fb470fcd0d8 .functor BUFZ 1, C4<z>; HiZ drive
v0x55b83c115b70_0 .net "rst_n", 0 0, o0x7fb470fcd0d8;  0 drivers
E_0x55b83c0ccd60 .event posedge, v0x55b83c0ddd50_0;
    .scope S_0x55b83c0cc710;
T_0 ;
    %wait E_0x55b83c0ccd60;
    %load/vec4 v0x55b83c115b70_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x55b83c0de430_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55b83c115ab0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55b83c1159e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55b83c0de430_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x55b83c0de430_0, 0;
    %load/vec4 v0x55b83c0de430_0;
    %pushi/vec4 15, 0, 4;
    %cmp/e;
    %flag_get/vec4 4;
    %assign/vec4 v0x55b83c115ab0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55b83c115ab0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
