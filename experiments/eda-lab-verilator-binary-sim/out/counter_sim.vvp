    %assign/vec4 v0x5569fe13d7e0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5569fe13d8c0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x5569fe13d7e0_0;
    %addi 1, 0, 32;
    %assign/vec4 v0x5569fe13d7e0_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
