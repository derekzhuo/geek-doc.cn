    .scope S_0x5569fe1285e0;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5569fe13dd90_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5569fe13dc90_0, 0, 1;
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5569fe13dd90_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5569fe13dc90_0, 0, 1;
    %pushi/vec4 10000000, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
