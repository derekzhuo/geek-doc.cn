E_0x5569fe102660 .event posedge, v0x5569fe1159a0_0;
    .scope S_0x5569fe0ee490;
T_0 ;
    %wait E_0x5569fe102660;
    %load/vec4 v0x5569fe13d990_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
