/* 教学用最小 liberty：门控时钟演示，标量延时，不对应任何真实工艺；产线请替换为 PDK 签核库 */
library(teaching) {
  time_unit : "1ns";
  delay_model : table_lookup;
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1, pf);
  input_threshold_pct_rise : 50.0;
  output_threshold_pct_rise : 50.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_lower_threshold_pct_fall : 20.0;
  slew_upper_threshold_pct_fall : 80.0;
  cell(BUF_X1) {
    pin(A) { direction : input; }
    pin(Y) {
      direction : output;
      function : "A";
      timing() {
        related_pin : "A";
        timing_type : combinational;
        cell_rise(scalar) { values("0.20"); }
        cell_fall(scalar) { values("0.20"); }
        rise_transition(scalar) { values("0.10"); }
        fall_transition(scalar) { values("0.10"); }
      }
    }
  }
  cell(BUF_D1) {
    pin(A) { direction : input; }
    pin(Y) {
      direction : output;
      function : "A";
      timing() {
        related_pin : "A";
        timing_type : combinational;
        cell_rise(scalar) { values("1.60"); }
        cell_fall(scalar) { values("1.60"); }
        rise_transition(scalar) { values("0.30"); }
        fall_transition(scalar) { values("0.30"); }
      }
    }
  }
  cell(AND2_X1) {
    pin(A) { direction : input; }
    pin(B) { direction : input; }
    pin(Y) {
      direction : output;
      function : "A & B";
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(scalar) { values("0.10"); }
        cell_fall(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.08"); }
        fall_transition(scalar) { values("0.08"); }
      }
      timing() {
        related_pin : "B";
        timing_sense : positive_unate;
        cell_rise(scalar) { values("0.10"); }
        cell_fall(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.08"); }
        fall_transition(scalar) { values("0.08"); }
      }
    }
  }
  cell(DFF_X1) {
    ff(IQ, IQN) { clocked_on : "C"; next_state : "D"; }
    pin(C) { direction : input; clock : true; }
    pin(D) {
      direction : input;
      timing() {
        related_pin : "C";
        timing_type : setup_rising;
        rise_constraint(scalar) { values("0.10"); }
        fall_constraint(scalar) { values("0.10"); }
      }
      timing() {
        related_pin : "C";
        timing_type : hold_rising;
        rise_constraint(scalar) { values("0.05"); }
        fall_constraint(scalar) { values("0.05"); }
      }
    }
    pin(Q) {
      direction : output;
      function : "IQ";
      timing() {
        related_pin : "C";
        timing_type : rising_edge;
        cell_rise(scalar) { values("0.15"); }
        cell_fall(scalar) { values("0.15"); }
        rise_transition(scalar) { values("0.10"); }
        fall_transition(scalar) { values("0.10"); }
      }
    }
  }
}
