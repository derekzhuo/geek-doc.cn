library (tiny_ff) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  cell (invx1) {
    area : 0.68;
    pin (a) {
      direction : input;
      capacitance : 0.001;
    }
    pin (z) {
      direction : output;
      function : "!a";
      timing () {
        related_pin : "a";
        cell_rise (scalar) {
          values ("0.01");
        }
        cell_fall (scalar) {
          values ("0.01");
        }
        rise_transition (scalar) {
          values ("0.01");
        }
        fall_transition (scalar) {
          values ("0.01");
        }
      }
    }
  }
}
