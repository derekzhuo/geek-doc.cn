(DELAYFILE
  (DESIGN "counter")
  (PROGRAM "gen_sdf.awk teaching delay table")
  (TIMESCALE 1ps)
  (CELL (CELLTYPE "$_NOT_")
    (INSTANCE _04_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (20:20:20) (18:18:18))
))
  )
  (CELL (CELLTYPE "$_NAND_")
    (INSTANCE _05_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (30:30:30) (25:25:25))
      (IOPATH B Y (30:30:30) (25:25:25))
))
  )
  (CELL (CELLTYPE "$_NAND_")
    (INSTANCE _06_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (30:30:30) (25:25:25))
      (IOPATH B Y (30:30:30) (25:25:25))
))
  )
  (CELL (CELLTYPE "$_OR_")
    (INSTANCE _07_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (30:30:30) (26:26:26))
      (IOPATH B Y (30:30:30) (26:26:26))
))
  )
  (CELL (CELLTYPE "$_ANDNOT_")
    (INSTANCE _08_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (30:30:30) (25:25:25))
      (IOPATH B Y (30:30:30) (25:25:25))
))
  )
  (CELL (CELLTYPE "$_XOR_")
    (INSTANCE _09_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (40:40:40) (35:35:35))
      (IOPATH B Y (40:40:40) (35:35:35))
))
  )
  (CELL (CELLTYPE "$_XNOR_")
    (INSTANCE _10_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (40:40:40) (35:35:35))
      (IOPATH B Y (40:40:40) (35:35:35))
))
  )
  (CELL (CELLTYPE "$_ANDNOT_")
    (INSTANCE _11_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (30:30:30) (25:25:25))
      (IOPATH B Y (30:30:30) (25:25:25))
))
  )
  (CELL (CELLTYPE "$_XOR_")
    (INSTANCE _12_)
    (DELAY (ABSOLUTE
      (IOPATH A Y (40:40:40) (35:35:35))
      (IOPATH B Y (40:40:40) (35:35:35))
))
  )
  (CELL (CELLTYPE "$_DFFE_PN0P_")
    (INSTANCE q3_reg)
    (DELAY (ABSOLUTE
      (IOPATH C Q (80:80:80) (70:70:70))
      (IOPATH R Q (60:60:60) (60:60:60))
))
  )
  (CELL (CELLTYPE "$_DFFE_PN0P_")
    (INSTANCE q0_reg)
    (DELAY (ABSOLUTE
      (IOPATH C Q (80:80:80) (70:70:70))
      (IOPATH R Q (60:60:60) (60:60:60))
))
  )
  (CELL (CELLTYPE "$_DFFE_PN0P_")
    (INSTANCE q1_reg)
    (DELAY (ABSOLUTE
      (IOPATH C Q (80:80:80) (70:70:70))
      (IOPATH R Q (60:60:60) (60:60:60))
))
  )
  (CELL (CELLTYPE "$_DFFE_PN0P_")
    (INSTANCE q2_reg)
    (DELAY (ABSOLUTE
      (IOPATH C Q (80:80:80) (70:70:70))
      (IOPATH R Q (60:60:60) (60:60:60))
))
  )
)
